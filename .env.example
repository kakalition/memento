# Copy to .env and fill in. The only required value is your provider key.
OPENAI_API_KEY=
AGENT_NAME=memento
OWNER_ID=owner
OWNER_NAME=Owner
MODEL_NAME=openai:gpt-4o-mini
# Enable the durable queue (agentkit queue:work) instead of running jobs inline.
QUEUE_ENABLED=false
QUEUE_DEFAULT=default
# Optional:
# AGENTKIT_HOME=~/.agentkit
# OBSERVABILITY=off

# -- Providers (set the key for the provider in MODEL_NAME) ------------------
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OPENAI_BASE_URL=            # for openai-compatible endpoints
# -- Semantic recall (extra: `uv sync --extra memory`) -----------------------
# MEMORY_EMBEDDING_BACKEND=sentence-transformers
# -- Channels (each activates only when its token/env is present) ------------
# TELEGRAM_BOT_TOKEN=
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
# DISCORD_BOT_TOKEN=
# EMAIL_IMAP_HOST=
# EMAIL_SMTP_HOST=
# EMAIL_FROM=
# -- Multi-agent ------------------------------------------------------------
SUBAGENTS_ENABLED=false
# -- Self-learning (reflect -> learn -> apply) -------------------------------
LEARNING_ENABLED=true
# LEARNING_REFLECT_CRON=0 4 * * *
# -- Native toolkits (opt-out; reachable models/tasks/jobs stay allow-listed) -
# DB_TOOLS_ENABLED=true
# SCHEDULER_TOOLS_ENABLED=true
# QUEUE_TOOLS_ENABLED=true
# NOTIFICATION_TOOLS_ENABLED=true
# HISTORY_TOOLS_ENABLED=true
# USAGE_TOOLS_ENABLED=true
# KNOWLEDGE_ADMIN_ENABLED=true
# SKILL_AUTHORING_ENABLED=true
